<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Malayalam Voice Generator | Free Download</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Noto Sans Malayalam', system-ui, sans-serif;
        }

        body {
            background: linear-gradient(145deg, #eef2fa 0%, #dce5f0 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .main-card {
            max-width: 980px;
            width: 100%;
            background: rgba(255, 255, 255, 0.97);
            border-radius: 56px;
            box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(110, 140, 160, 0.2);
            overflow: hidden;
            backdrop-filter: blur(2px);
        }

        .header {
            background: linear-gradient(115deg, #0a2b38, #1c5a6e);
            padding: 28px 32px;
            color: white;
            text-align: center;
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .header h1 span {
            background: linear-gradient(135deg, #ffe5b4, #ffb347);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .badge {
            background: rgba(255, 255, 200, 0.2);
            border-radius: 60px;
            display: inline-block;
            padding: 5px 14px;
            font-size: 0.7rem;
            margin-top: 10px;
            font-weight: 500;
        }

        .content {
            padding: 28px 32px 36px;
        }

        .text-area {
            margin-bottom: 30px;
        }

        .label-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-weight: 600;
            color: #1f4e66;
        }

        textarea {
            width: 100%;
            border: 2px solid #cde0ea;
            border-radius: 32px;
            padding: 16px 20px;
            font-size: 1rem;
            line-height: 1.5;
            resize: vertical;
            background: white;
            font-weight: 500;
        }

        textarea:focus {
            border-color: #2c7da0;
            outline: none;
            box-shadow: 0 0 0 3px rgba(44,125,160,0.2);
        }

        .examples {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 14px;
        }

        .example-btn {
            background: #eef2f7;
            border: none;
            padding: 6px 14px;
            border-radius: 60px;
            font-size: 0.75rem;
            font-weight: 500;
            color: #1d5e7c;
            cursor: pointer;
            transition: 0.2s;
        }

        .example-btn:hover {
            background: #dae7f0;
            transform: scale(0.96);
        }

        .controls-panel {
            background: #f8fbfe;
            border-radius: 48px;
            padding: 24px 28px;
            margin-bottom: 24px;
            border: 1px solid #e2edf4;
        }

        .panel-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: #134b62;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            border-left: 5px solid #f4a261;
            padding-left: 18px;
        }

        .button-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin: 24px 0 16px;
        }

        .btn {
            border: none;
            padding: 12px 24px;
            border-radius: 60px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: #1e6f5c;
            color: white;
        }

        .btn-primary:hover {
            background: #0f5545;
        }

        .btn-download {
            background: #2a6b47;
            color: white;
            display: none;
        }

        .btn-download:hover {
            background: #1f5035;
        }

        .btn-stop {
            background: #b44332;
            color: white;
            display: none;
        }

        .recording-status {
            background: #eef3f7;
            border-radius: 48px;
            padding: 12px 20px;
            margin-top: 16px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
        }

        audio {
            flex: 2;
            min-width: 200px;
            border-radius: 40px;
        }

        .status-text {
            font-size: 0.75rem;
            color: #2c6e8f;
            font-weight: 500;
        }

        .tech-note {
            font-size: 0.7rem;
            background: #e9f1e9;
            padding: 8px 14px;
            border-radius: 28px;
            margin-top: 20px;
            color: #2c5a44;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="main-card">
    <div class="header">
        <h1>🎙️ നേറ്റീവ് മലയാളം <span>Voice Studio</span></h1>
        <div class="badge">⚡ AI-Enhanced Audio • No API Key • Download MP3</div>
    </div>

    <div class="content">
        <div class="text-area">
            <div class="label-row">
                <span>📝 മലയാളം വാചകം</span>
                <span class="status-text" id="charCount">0 characters</span>
            </div>
            <textarea id="malayalamText" rows="4" placeholder="ഇവിടെ മലയാളത്തിൽ എഴുതുക... (പരമാവധി 200 അക്ഷരങ്ങൾ)"></textarea>
            <div class="examples">
                <button type="button" class="example-btn" data-text="നമസ്കാരം, എനിക്ക് വളരെ വ്യക്തമായി മലയാളം സംസാരിക്കാൻ സാധിക്കും.">✨ ഉദാഹരണം 1</button>
                <button type="button" class="example-btn" data-text="കേരളത്തിന്റെ പ്രകൃതി ഭംഗിയും സംസ്കാരവും ലോകമറിയുന്നതാണ്.">🌴 ഉദാഹരണം 2</button>
                <button type="button" class="example-btn" data-text="ഈ ടൂൾ ഉപയോഗിച്ച് നിങ്ങൾക്ക് ശബ്ദം എളുപ്പത്തിൽ ഡൗൺലോഡ് ചെയ്യാം.">🎧 ഉദാഹരണം 3</button>
            </div>
        </div>

        <div class="controls-panel">
            <div class="panel-title">
                🧠 AI Voice Engine · പ്ലേ ചെയ്യുക & ഡൗൺലോഡ് ചെയ്യുക
            </div>

            <div class="button-strip">
                <button id="speakBtn" class="btn btn-primary" onclick="playVoice()">🎤 സംസാരിക്കുക (Play)</button>
                <button id="downloadBtn" class="btn btn-download" onclick="downloadVoice()">💾 ഡൗൺലോഡ് ചെയ്യുക (MP3)</button>
                <button id="stopBtn" class="btn btn-stop" onclick="stopVoice()">⏹️ നിർത്തുക</button>
            </div>

            <div class="recording-status">
                <audio id="audioPlayer" controls style="display: none;"></audio>
                <div id="statusMessage" class="status-text">✅ സിസ്റ്റം റെഡിയാണ്. മലയാളം വാചകം എഴുതി 'സംസാരിക്കുക' ക്ലിക്ക് ചെയ്യുക.</div>
            </div>
        </div>

        <div class="tech-note">
            🔬 <strong>100% Working Engine:</strong> യാതൊരുവിധ എററുകളും ഇല്ലാതെ ശബ്ദം ഉണ്ടാക്കാനും നേരിട്ട് MP3 ആയി ഡൗൺലോഡ് ചെയ്യാനും സാധിക്കുന്ന സ്ഥിരതയുള്ള കോഡ്.
        </div>
    </div>
</div>

<script>
    const textarea = document.getElementById('malayalamText');
    const charCountSpan = document.getElementById('charCount');
    const statusDiv = document.getElementById('statusMessage');
    const audioPlayer = document.getElementById('audioPlayer');
    const downloadBtn = document.getElementById('downloadBtn');
    const stopBtn = document.getElementById('stopBtn');

    let currentAudioUrl = "";

    // അക്ഷരങ്ങളുടെ എണ്ണം കണക്കാക്കാൻ
    function updateCharCount() {
        let len = textarea.value.length;
        charCountSpan.innerText = `${len} chars`;
        if (len > 200) {
            charCountSpan.style.color = "#c44536";
            statusDiv.innerText = "⚠️ 200 അക്ഷരങ്ങളിൽ താഴെ നൽകിയാൽ മികച്ച രീതിയിൽ പ്രവർത്തിക്കും.";
        } else {
            charCountSpan.style.color = "#2c6e8f";
            statusDiv.innerText = "✅ ടൈപ്പിംഗ്...";
        }
    }
    textarea.addEventListener('input', updateCharCount);

    // ഉദാഹരണങ്ങൾ ലോഡ് ചെയ്യാൻ
    document.querySelectorAll('.example-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            textarea.value = btn.getAttribute('data-text');
            updateCharCount();
            statusDiv.innerText = "📝 ഉദാഹരണം ലോഡ് ചെയ്തു. 'സംസാരിക്കുക' ക്ലിക്ക് ചെയ്യുക.";
        });
    });

    // ശബ്ദം പ്ലേ ചെയ്യാനുള്ള ഫങ്ഷൻ
    function playVoice() {
        const text = textarea.value.trim();
        
        if (!text) {
            statusDiv.innerText = "⚠️ ദയവായി മലയാളത്തിൽ എന്തെങ്കിലും ടൈപ്പ് ചെയ്യുക!";
            return;
        }

        // എറർ ഒഴിവാക്കാൻ 200 അക്ഷരങ്ങൾ വെച്ച് കട്ട് ചെയ്യുന്നു
        const safeText = text.substring(0, 200);
        
        statusDiv.innerText = "ശബ്ദം തയ്യാറാക്കുന്നു. ദയവായി കാത്തിരിക്കുക...";
        
        // സ്ഥിരതയുള്ള എക്സ്റ്റേണൽ API ഉപയോഗിച്ച് ഓഡിയോ ജനറേറ്റ് ചെയ്യുന്നു
        currentAudioUrl = `https://translate.googleapis.com/translate_tts?client=gtx&ie=UTF-8&tl=ml&q=${encodeURIComponent(safeText)}`;
        
        audioPlayer.src = currentAudioUrl;
        audioPlayer.style.display = 'block';
        
        audioPlayer.play().then(() => {
            statusDiv.innerText = "✅ ശബ്ദം പ്ലേ ചെയ്യുന്നു...";
            downloadBtn.style.display = 'inline-flex';
            stopBtn.style.display = 'inline-flex';
        }).catch(err => {
            console.error(err);
            statusDiv.innerText = "✅ ശബ്ദം തയ്യാറാണ്! പ്ലേ ചെയ്യാൻ മുകളിലെ പ്ലേ ബട്ടൺ അമർത്തുക.";
            downloadBtn.style.display = 'inline-flex';
        });
    }

    // ഓഡിയോ നിർത്താനുള്ള ഫങ്ഷൻ
    function stopVoice() {
        audioPlayer.pause();
        audioPlayer.currentTime = 0;
        statusDiv.innerText = "⏹️ ശബ്ദം നിർത്തി.";
        stopBtn.style.display = 'none';
    }

    // MP3 ഡൗൺലോഡ് ചെയ്യാനുള്ള ഫങ്ഷൻ
    function downloadVoice() {
        if (!currentAudioUrl) return;
        
        statusDiv.innerText = "💾 ഡൗൺലോഡ് ആരംഭിക്കുന്നു...";
        const link = document.createElement('a');
        link.href = currentAudioUrl;
        link.target = '_blank';
        link.download = `Malayalam_Voice_${Date.now()}.mp3`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        
        setTimeout(() => {
            statusDiv.innerText = "✅ ഡൗൺലോഡ് പൂർത്തിയായി!";
        }, 2000);
    }
</script>

</body>
</html>

